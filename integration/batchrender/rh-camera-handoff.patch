+
+bool UJobLibrary::ConsumeCameraFocalLengthOverride(const FString& SequenceName, float& OutFocalLength)
+{
+	FScopeLock Lock(&CameraOverrideLock);
+	TArray<float>* Overrides = CameraFocalLengthOverrides.Find(SequenceName);
+	if (!Overrides || Overrides->IsEmpty()) return false;
+	OutFocalLength = (*Overrides)[0];
+	Overrides->RemoveAt(0);
+	if (Overrides->IsEmpty()) CameraFocalLengthOverrides.Remove(SequenceName);
+	return OutFocalLength > 0.0f;
+}
